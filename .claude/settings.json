{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/src/bash-guard.ts\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/src/bash-guard.ts\""
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/src/bash-guard.ts\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/src/git-sync.ts\" pull"
          },
          {
            "type": "command",
            "command": "node --experimental-strip-types --no-warnings \"$CLAUDE_PROJECT_DIR/src/warmup.ts\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "yoke@yoke": false,
    "mattpocock-skills@claude-plugins-official": false
  }
}
