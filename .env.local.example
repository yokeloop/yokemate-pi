# YouTrack instances. One URL/TOKEN pair per organization. The name between
# YT_ and _URL becomes the tracker alias, with underscores read as dashes:
# YT_ACME_EU_URL -> acme-eu (src/trackers.ts). Both keys of a pair are
# required — a URL without its token aborts every command that reads trackers.
YT_ACME_URL=https://acme.youtrack.cloud
YT_ACME_TOKEN=perm:...

# Figma MCP and other secrets, if the passports name them.
